# ==============================================================
#  IBM Cloud / watsonx.ai Credentials
# ==============================================================

# IBM Cloud API Key (required)
# Get yours at: https://cloud.ibm.com/iam/apikeys
IBM_WATSONX_API_KEY=your_ibm_cloud_api_key_here

# IBM watsonx.ai Project ID (required)
# Found in your watsonx.ai project settings
IBM_WATSONX_PROJECT_ID=your_watsonx_project_id_here

# IBM watsonx.ai Service URL (region-specific)
# Options:
#   us-south : https://us-south.ml.cloud.ibm.com
#   eu-de    : https://eu-de.ml.cloud.ibm.com
#   eu-gb    : https://eu-gb.ml.cloud.ibm.com
#   jp-tok   : https://jp-tok.ml.cloud.ibm.com
#   au-syd   : https://au-syd.ml.cloud.ibm.com
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ==============================================================
#  IBM Granite Model IDs  (Lite-tier -- free to use)
# ==============================================================

# Primary model for admission reasoning & RAG responses
IBM_GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# Lighter/faster model for quick queries
IBM_GRANITE_LITE_MODEL_ID=ibm/granite-3-2b-instruct

# ==============================================================
#  App Settings
# ==============================================================

APP_NAME="College Admission Agent"
DEBUG=false

# ==============================================================
#  CORS  (comma-separated list of allowed frontend origins)
# ==============================================================
CORS_ORIGINS=["http://localhost:3000"]

# ==============================================================
#  JWT Auth
# ==============================================================
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_super_secret_jwt_key_minimum_32_chars_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================
#  Embeddings
# ==============================================================
# HuggingFace model downloaded locally on first run (~90 MB)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ==============================================================
#  ChromaDB  (vector store)
# ==============================================================
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=college_docs

# ==============================================================
#  File Uploads
# ==============================================================
UPLOAD_DIR=./data/uploaded_pdfs
MAX_UPLOAD_SIZE_MB=50

# ==============================================================
#  RAG Tuning
# ==============================================================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_TOP_K=5

# ==============================================================
#  SQLite Database
# ==============================================================
DATABASE_URL=sqlite:///./data/admission_agent.db
